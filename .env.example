# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Supabase (server & SSR)
SUPABASE_PROJECT_ID="your-supabase-project-id"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_URL="https://your-supabase-project-id.supabase.co"

# Supabase (Vite client)
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"

# Optional server-only secrets (configure in your secret store / deployment env)
# SUPABASE_SERVICE_ROLE_KEY=""
# AUTOMAS_SMS_API_KEY=""
# LOVABLE_CRON_SECRET=""
# LOVABLE_CRON_SECRET_PREVIOUS=""
# LOVABLE_DB_MIGRATION_URL=""
